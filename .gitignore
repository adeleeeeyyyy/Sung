# Public source allowlist. Review new top-level paths and assets before adding them.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/CMakeLists.txt
!/src/
!/qml/
!/helper/
!/scripts/
!/tests/
!/assets/
!/licenses/
!/.github/

/.github/*
!/.github/workflows/
!/.github/workflows/*.yml

/src/*
!/src/*.cpp
!/src/*.h
/qml/*
!/qml/*.qml
/helper/*
!/helper/catalog.py
!/helper/requirements.txt
/scripts/*
!/scripts/*.sh
/tests/*
!/tests/*.cpp
!/tests/*.h
!/tests/*.py
/assets/*
!/assets/readme-banner.png
!/assets/sung.svg
!/assets/sung.desktop
!/assets/icons/
/assets/icons/*
!/assets/icons/*.svg
/licenses/*
!/licenses/MaterialSymbols-LICENSE.txt

# Build output & packages
/build/
/build-*/
/build-output/
/build-tests/
/_CPack_Packages/
/AppDir/
/*.AppImage
/*.deb
/*.tar.gz
/*.tar.xz
/*.rpm
/*.zip
/*.7z

# C++ & Qt build artifacts
*.o
*.obj
*.so
*.so.*
*.a
*.dylib
*.dll
*.exe
*_autogen/
moc_*.cpp
qrc_*.cpp
ui_*.h
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
build.ninja
compile_commands.json

# Python virtual environments & caches
/runtime/
/venv/
/.venv/
/env/
**/__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Private state, credentials, logs & local data
library.json
settings.json
*.db
*.sqlite
*.sqlite3
*.log
.env
.env.*
*.pem
*.key
*.p12
*.pfx
cookies*
credentials*
secrets*

# IDE, Editor & Assistant files
.vscode/
.idea/
.qt-creator/
.cache/
.ccls-cache/
.agents/
.codex/
.gemini/
.claude/
.cursor/
.copilot/
*.user
*.userosv
*.swp
*.swo
*~
*.tmp
*.bak

# OS generated files
.DS_Store
Thumbs.db
.directory

# README is the only Markdown file in the public repository.
*.[mM][dD]
*.[mM][aA][rR][kK][dD][oO][wW][nN]
!/README.md
